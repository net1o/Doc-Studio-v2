# Document Studio environment contract (never commit .env.local or real secrets)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Isolated Supabase project credentials (to be configured after project approval)
NEXT_PUBLIC_SUPABASE_URL="https://your-isolated-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"

# Server-only worker secret for bounded DOCX/PDF conversion
EXPORT_WORKER_SECRET="server-only-export-worker-secret"
