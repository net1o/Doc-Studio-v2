function getOrCreateFolder_(parent, name) {
  const it = parent.getFoldersByName(name);
  return it.hasNext() ? it.next() : parent.createFolder(name);
}

function generateDocumentFromTemplate_(templateId, folder, docName, mergeTags) {
  const templateFile = DriveApp.getFileById(templateId);
  const newFile      = templateFile.makeCopy(docName, folder);
  const docId        = newFile.getId();

  const doc  = DocumentApp.openById(docId);
  const body = doc.getBody();

  Object.keys(mergeTags).forEach(tag => {
    const value   = String(mergeTags[tag] || "");
    const escaped = escapeRegExp_(tag);
    try {
      body.replaceText(escaped, value);
    } catch (e) {
      Logger.log("replaceText failed: " + tag + " -> " + e);
    }
  });

  doc.saveAndClose();
  return docId;
}

function exportDocToPdf_(docId, pdfFolder, baseName) {
  try {
    const url    = `https://www.googleapis.com/drive/v3/files/${docId}/export?mimeType=application/pdf`;
    const params = {
      method:  "get",
      headers: { Authorization: "Bearer " + ScriptApp.getOAuthToken() },
      muteHttpExceptions: true,
    };
    const resp = UrlFetchApp.fetch(url, params);
    if (resp.getResponseCode() >= 200 && resp.getResponseCode() < 300) {
      const blob    = resp.getBlob().setName(baseName + ".pdf");
      const pdfFile = pdfFolder.createFile(blob);
      return pdfFile.getUrl();
    }
  } catch (e) {
    Logger.log("Drive export failed, fallback: " + e);
  }

  const file    = DriveApp.getFileById(docId);
  const blob    = file.getBlob().getAs(MimeType.PDF);
  const pdfFile = pdfFolder.createFile(blob).setName(baseName + ".pdf");
  return pdfFile.getUrl();
}

function getNextSerial_(reviewSheet, generatedDocIdx0) {
  const lastRow = reviewSheet.getLastRow();
  if (lastRow < 2) return 1;

  const col  = generatedDocIdx0 + 1;
  const vals = reviewSheet.getRange(2, col, lastRow - 1, 1).getValues();
  let count  = 0;
  for (let i = 0; i < vals.length; i++) {
    if (String(vals[i][0] || "").trim()) count++;
  }
  return count + 1;
}


