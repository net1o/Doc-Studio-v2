function sheetHasData_(sheet) {
  if (!sheet) return false;
  return sheet.getLastRow() > 1;
}

function dashboardHasData_(sheet) {
  if (!sheet) return false;
  const jn = String(sheet.getRange(CFG.DASH_JOURNAL_NO_A1).getValue() || "").trim();
  const kw = sheet
    .getRange(CFG.DASH_KEYWORDS_RANGE_A1)
    .getValues()
    .some(row => String(row[0] || "").trim());
  return !!jn || kw;
}

function migrateSheetToHeaders_(sheet, newHeaders, defaults) {
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();

  if (lastRow < 1 || lastCol < 1) {
    sheet.getRange(1, 1, 1, newHeaders.length).setValues([newHeaders]);
    return { migrated: false, rowCount: 0 };
  }

  const oldHeaders = sheet
    .getRange(1, 1, 1, lastCol)
    .getValues()[0]
    .map(h => String(h || "").trim());

  const sameShape =
    oldHeaders.length === newHeaders.length &&
    oldHeaders.every((h, i) => h === newHeaders[i]);
  if (sameShape) return { migrated: false, rowCount: Math.max(0, lastRow - 1) };

  const oldIdx = {};
  oldHeaders.forEach((h, i) => { if (h) oldIdx[h] = i; });

  const oldData = lastRow > 1
    ? sheet.getRange(2, 1, lastRow - 1, lastCol).getValues()
    : [];

  const newData = oldData.map(oldRow =>
    newHeaders.map(h => {
      if (h in oldIdx) return oldRow[oldIdx[h]];
      return defaults && h in defaults ? defaults[h] : "";
    })
  );

  sheet.clear();
  sheet.getRange(1, 1, 1, newHeaders.length).setValues([newHeaders]);
  if (newData.length > 0) {
    sheet.getRange(2, 1, newData.length, newHeaders.length).setValues(newData);
  }

  return { migrated: true, rowCount: newData.length };
}

function backfillDecisionDefaults_(review) {
  const lastRow = review.getLastRow();
  if (lastRow < 2) return;

  const headers = review.getRange(1, 1, 1, review.getLastColumn()).getValues()[0];
  const idx = makeIndex_(headers);
  if (!("Decision" in idx)) return;

  const range  = review.getRange(2, idx["Decision"] + 1, lastRow - 1, 1);
  const values = range.getValues();
  let changed  = false;

  for (let i = 0; i < values.length; i++) {
    if (!String(values[i][0] || "").trim()) {
      values[i][0] = CFG.DECISION_PENDING;
      changed = true;
    }
  }
  if (changed) range.setValues(values);
}

function setupReviewValidation_(sheet) {
  const idx     = makeIndex_(REVIEW_HEADERS);
  const maxRows = 2000;

  const decisionRule = SpreadsheetApp.newDataValidation()
    .requireValueInList([CFG.DECISION_PENDING, CFG.DECISION_ISSUE, CFG.DECISION_CLEAR], true)
    .setAllowInvalid(true)
    .build();
  sheet.getRange(2, idx["Decision"] + 1, maxRows, 1).setDataValidation(decisionRule);

  const statusRule = SpreadsheetApp.newDataValidation()
    .requireValueInList([CFG.STATUS_REVIEW, CFG.STATUS_OK, CFG.STATUS_DONE], true)
    .setAllowInvalid(true)
    .build();
  sheet.getRange(2, idx["Status"] + 1, maxRows, 1).setDataValidation(statusRule);
}

function ensureSheet_(ss, name) {
  return ss.getSheetByName(name) || ss.insertSheet(name);
}

function ensureReviewHeaders_(sheet) {
  if (sheet.getLastRow() < 1 || !sheet.getRange(1, 1).getValue()) {
    sheet.getRange(1, 1, 1, REVIEW_HEADERS.length).setValues([REVIEW_HEADERS]);
  }
}

function ensureRecordsHeaders_(sheet) {
  if (sheet.getLastRow() < 1 || !sheet.getRange(1, 1).getValue()) {
    sheet.getRange(1, 1, 1, RECORDS_HEADERS.length).setValues([RECORDS_HEADERS]);
  }
}

function formatReviewSheet_(sheet) {
  sheet.getRange(1, 1, 1, REVIEW_HEADERS.length)
    .setFontWeight("bold")
    .setBackground(UI_CFG.HEADER_BG)
    .setFontColor(UI_CFG.HEADER_FG);
  sheet.setFrozenRows(1);
}

function formatRecordsSheet_(sheet) {
  sheet.getRange(1, 1, 1, RECORDS_HEADERS.length)
    .setFontWeight("bold")
    .setBackground(UI_CFG.HEADER_BG)
    .setFontColor(UI_CFG.HEADER_FG);
  sheet.setFrozenRows(1);
}


