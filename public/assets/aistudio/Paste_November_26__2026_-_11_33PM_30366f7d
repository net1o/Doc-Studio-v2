function runScan() {
  const ss = SpreadsheetApp.getActive();

  const dashboard = ss.getSheetByName(CFG.SHEET_DASHBOARD);
  const journal   = ss.getSheetByName(CFG.SHEET_JOURNAL);
  const review    = ensureSheet_(ss, CFG.SHEET_REVIEW);

  if (!dashboard) {
    notify_(`Sheet '${CFG.SHEET_DASHBOARD}' not found. Run Setup first.`);
    return;
  }
  if (!journal) {
    notify_(`Sheet '${CFG.SHEET_JOURNAL}' not found. Setup chalao — sheet auto-ban jayegi.`);
    return;
  }

  const journalNo   = String(dashboard.getRange(CFG.DASH_JOURNAL_NO_A1).getValue() || "").trim();
  const journalDate = dashboard.getRange(CFG.DASH_JOURNAL_DATE_A1).getValue();

  if (!journalNo) {
    notify_(`Dashboard!${CFG.DASH_JOURNAL_NO_A1} khali hai. Journal No daalo (e.g. 898).`);
    return;
  }

  const keywords = readNonBlankStrings_(
    dashboard.getRange(CFG.DASH_KEYWORDS_RANGE_A1).getValues()
  ).map(s => s.trim()).filter(Boolean);

  const tmNumbers = readNonBlankStrings_(
    dashboard.getRange(CFG.DASH_TM_RANGE_A1).getValues()
  ).map(s => s.trim()).filter(s => /^\d{6}$/.test(s));

  if (keywords.length === 0 && tmNumbers.length === 0) {
    notify_(
      `Dashboard mein koi keyword ya 6-digit TM number nahi mila:\n` +
      `- ${CFG.DASH_KEYWORDS_RANGE_A1}\n- ${CFG.DASH_TM_RANGE_A1}`
    );
    return;
  }

  const headerMap = getHeaderMap_(journal);
  const requiredHeaders = [
    "Application No", "Title", "Class",
    "Applicant Name and Address",
    "Agent Name and Address",
    "Date of Filing",
  ];
  for (const h of requiredHeaders) {
    if (!(h in headerMap)) {
      notify_(`JournalCheck sheet mein column missing: ${h}`);
      return;
    }
  }
  const pageNoColIdx = "Page No" in headerMap ? headerMap["Page No"] : -1;

  const lastRow = journal.getLastRow();
  if (lastRow < 2) {
    notify_("JournalCheck sheet mein koi data nahi. VBA se convert karke paste karo.");
    return;
  }

  const rows = journal
    .getRange(2, 1, lastRow - 1, journal.getLastColumn())
    .getValues();

  const tmSet              = new Set(tmNumbers);
  const normalizedKeywords = keywords.map(k => normalizeKeyword_(k));
  const caseMap            = buildCaseNumberMap_();

  ensureReviewHeaders_(review);
  const existingKeys = getExistingReviewKeys_(review);

  const outRows = [];
  let matchedCount     = 0;
  let skippedDuplicate = 0;

  for (let i = 0; i < rows.length; i++) {
    const r = rows[i];

    const applicationNo = String(r[headerMap["Application No"]] || "").trim();
    const title         = String(r[headerMap["Title"]]           || "").trim();
    const classNo       = String(r[headerMap["Class"]]           || "").trim();
    const applicant     = String(r[headerMap["Applicant Name and Address"]] || "").trim();
    const agent         = String(r[headerMap["Agent Name and Address"]]     || "").trim();
    const filingDateRaw = r[headerMap["Date of Filing"]] || "";
    const filingDate    = parseLooseDate_(filingDateRaw) || filingDateRaw;
    const pageNo        = pageNoColIdx >= 0 ? String(r[pageNoColIdx] || "").trim() : "";

    if (!applicationNo && !title && !applicant && !agent) continue;

    let matchType   = "";
    let matchedTerm = "";

    if (tmSet.has(applicationNo)) {
      matchType   = "TM";
      matchedTerm = applicationNo;
    } else {
      const hit = findKeywordHit_(normalizedKeywords, r);
      if (hit) {
        matchType   = "KEYWORD";
        matchedTerm = hit;
      }
    }

    if (!matchType) continue;

    const caseNo   = caseMap[applicationNo] || "NOT FOUND";
    const uniqueKey = `${journalNo}|${applicationNo}|${matchType}|${matchedTerm}`;

    if (existingKeys.has(uniqueKey)) {
      skippedDuplicate++;
      continue;
    }
    existingKeys.add(uniqueKey);

    outRows.push([
      journalNo,
      journalDate || "",
      applicationNo,
      caseNo,
      title,
      classNo,
      applicant,
      agent,
      filingDate,
      matchedTerm,
      matchType,
      CFG.DECISION_PENDING,
      CFG.STATUS_REVIEW,
      "",   // Generated Doc
      "",   // Generated PDF
      "",   // Generated At
      pageNo,
    ]);

    matchedCount++;
  }

  if (outRows.length > 0) {
    appendRows_(review, outRows);
    setupReviewValidation_(review);
    applyUniversalFormatting_(review);
    applyAlternatingRows_(review);
  }

  updateDashboardStats_();

  notify_(
    `Scan Complete ✅\n\nJournal: ${journalNo}\n` +
    `Total Rows: ${rows.length}\n` +
    `New Matches: ${matchedCount}\n` +
    `Skipped (duplicate): ${skippedDuplicate}`
  );
}


