function getHeaderMap_(sheet) {
  const headerRow = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
  const map       = {};
  for (let c = 0; c < headerRow.length; c++) {
    const name = String(headerRow[c] || "").trim();
    if (name) map[name] = c;
  }
  return map;
}

function readNonBlankStrings_(values2d) {
  const out = [];
  for (let i = 0; i < values2d.length; i++) {
    const s = String(values2d[i] && values2d[i][0] || "").trim();
    if (s) out.push(s);
  }
  return out;
}

function normalizeKeyword_(k) {
  return String(k || "").trim();
}

function findKeywordHit_(keywords, haystacks) {
  const hs = Array.isArray(haystacks) ? haystacks : [haystacks];
  for (let i = 0; i < keywords.length; i++) {
    const kw = keywords[i];
    if (!kw) continue;
    const kwLower = kw.toLowerCase();
    const re      =
      CFG.KEYWORD_MATCH_MODE === "word"
        ? buildWordBoundaryRegex_(kwLower)
        : null;

    for (let h = 0; h < hs.length; h++) {
      const t = String(hs[h] || "").toLowerCase();
      if (!t) continue;
      if (CFG.KEYWORD_MATCH_MODE === "contains") {
        if (t.includes(kwLower)) return kw;
      } else if (re && re.test(t)) {
        return kw;
      }
    }
  }
  return "";
}

function escapeRegExp_(str) {
  return String(str).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function buildWordBoundaryRegex_(keywordLower) {
  const escaped = escapeRegExp_(keywordLower);
  return new RegExp(`(^|[^a-z0-9])${escaped}([^a-z0-9]|$)`, "i");
}

function buildCaseNumberMap_() {
  try {
    const extSS = SpreadsheetApp.openById(CFG.EXTERNAL_SHEET_ID);
    const sh    = extSS.getSheetByName(CFG.EXTERNAL_SHEET_NAME);
    if (!sh) return {};

    const lastRow = sh.getLastRow();
    if (lastRow < 2) return {};

    const maxCol   = Math.max(CFG.EXTERNAL_KEY_COL, ...(CFG.EXTERNAL_VALUE_COLS || [2]));
    const data     = sh.getRange(2, 1, lastRow, maxCol).getValues();
    const map      = {};
    const keyIdx   = CFG.EXTERNAL_KEY_COL - 1;
    const valueIdxs = (CFG.EXTERNAL_VALUE_COLS || [2]).map(c => c - 1);

    for (let i = 0; i < data.length; i++) {
      const key = String(data[i][keyIdx] || "").trim();
      if (!key) continue;
      const values = valueIdxs
        .map(idx => String(data[i][idx] || "").trim())
        .filter(v => v !== "");
      if (!map[key]) map[key] = values.join("-") || "NOT FOUND";
    }
    return map;
  } catch (e) {
    Logger.log("Case lookup error: " + e);
    return {};
  }
}

function getExistingReviewKeys_(reviewSheet) {
  const keys    = new Set();
  const lastRow = reviewSheet.getLastRow();
  if (lastRow < 2) return keys;

  const lastCol = reviewSheet.getLastColumn();
  const headers = reviewSheet.getRange(1, 1, 1, lastCol).getValues()[0];
  const idx     = makeIndex_(headers);
  const data    = reviewSheet.getRange(2, 1, lastRow - 1, lastCol).getValues();

  for (let i = 0; i < data.length; i++) {
    const journalNo   = String(data[i][idx["Journal No"]]   || "").trim();
    const appNo       = String(data[i][idx["Application No"]] || "").trim();
    const matchedTerm = String(data[i][idx["Matched Term"]] || "").trim();
    const matchType   = String(data[i][idx["Match Type"]]   || "").trim();
    if (!journalNo || !appNo || !matchType) continue;
    keys.add(`${journalNo}|${appNo}|${matchType}|${matchedTerm}`);
  }
  return keys;
}

function appendRows_(sheet, rows) {
  const startRow = sheet.getLastRow() + 1;
  sheet.getRange(startRow, 1, rows.length, rows[0].length).setValues(rows);
}

function makeIndex_(headers) {
  const idx = {};
  for (let i = 0; i < headers.length; i++) {
    const h = String(headers[i] || "").trim();
    if (h) idx[h] = i;
  }
  return idx;
}


