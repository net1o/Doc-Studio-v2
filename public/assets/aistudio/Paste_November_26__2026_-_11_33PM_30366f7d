function normalizeJournalCheckFilingDates() {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CFG.SHEET_JOURNAL);
  if (!sh) {
    notify_(`Sheet '${CFG.SHEET_JOURNAL}' nahi mili.`);
    return;
  }

  const headerMap = getHeaderMap_(sh);
  if (!("Date of Filing" in headerMap)) {
    notify_(`'Date of Filing' column ${CFG.SHEET_JOURNAL} mein nahi mila.`);
    return;
  }
  const colF    = headerMap["Date of Filing"] + 1;
  const lastRow = sh.getLastRow();
  if (lastRow < 2) { notify_("JournalCheck mein koi data nahi."); return; }

  const range = sh.getRange(2, colF, lastRow - 1, 1);
  const vals  = range.getValues();
  const tz    = Session.getScriptTimeZone();
  let changed = 0;
  let failed  = 0;

  for (let i = 0; i < vals.length; i++) {
    const d = parseLooseDate_(vals[i][0]);
    if (!d) { failed++; continue; }
    vals[i][0] = Utilities.formatDate(d, tz, UI_CFG.DATE_FORMAT);
    changed++;
  }

  range.setValues(vals);
  range.setNumberFormat(UI_CFG.DATE_FORMAT);
  notify_(`Date normalize done ✅  Changed: ${changed} | Failed: ${failed}`);
}

function parseLooseDate_(value) {
  if (value === null || value === undefined || value === "") return null;

  if (
    Object.prototype.toString.call(value) === "[object Date]" &&
    !isNaN(value.getTime())
  ) return value;

  const s      = String(value).trim();
  if (!s)      return null;

  const native = new Date(s);
  if (!isNaN(native.getTime())) return native;

  const m = s.match(
    /^\s*(\d{1,2})[\-\/]([A-Za-z]{3}|\d{1,2})[\-\/](\d{2}|\d{4})\s*$/
  );
  if (!m) return null;

  const dd    = parseInt(m[1], 10);
  const mid   = m[2];
  const yyRaw = m[3];

  let mm = /^\d+$/.test(mid) ? parseInt(mid, 10) : monthAbbrevToNumber_(mid);
  if (!mm || mm < 1 || mm > 12) return null;

  let yyyy;
  if (yyRaw.length === 4) {
    yyyy = parseInt(yyRaw, 10);
  } else {
    const yy = parseInt(yyRaw, 10);
    yyyy = yy <= 49 ? 2000 + yy : 1900 + yy;
  }

  const d = new Date(yyyy, mm - 1, dd);
  return isNaN(d.getTime()) ? null : d;
}

function monthAbbrevToNumber_(mon) {
  const map = {
    jan:1, feb:2, mar:3, apr:4, may:5,  jun:6,
    jul:7, aug:8, sep:9, oct:10, nov:11, dec:12,
  };
  return map[String(mon || "").trim().toLowerCase()] || null;
}


