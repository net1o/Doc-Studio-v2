// ========================================

function setupSystem() {
  const ss = SpreadsheetApp.getActive();
  const ui = SpreadsheetApp.getUi();

  const dashboardExisting = ss.getSheetByName(CFG.SHEET_DASHBOARD);
  const reviewExisting    = ss.getSheetByName(CFG.SHEET_REVIEW);
  const recordsExisting   = ss.getSheetByName(CFG.SHEET_RECORDS);

  // -----------------------------------------------------------------------
  // Check karo kya existing sheets mein data hai
  // Agar hai to user se poochho — Full Reset ya Safe Refresh?
  // -----------------------------------------------------------------------
  const hasExistingData =
    dashboardHasData_(dashboardExisting) ||
    sheetHasData_(reviewExisting)        ||
    sheetHasData_(recordsExisting);

  let wipeMode = false;

  if (hasExistingData) {
    const resp = ui.alert(
      "⚠️ Confirm Setup",
      "Dashboard, Review aur/ya Records mein pehle se data hai.\n\n" +
        "• YES   = Full Reset — sab kuch erase ho jaye ga aur fresh start hoga.\n" +
        "• NO    = Safe Refresh — data safe rahe ga, sirf missing columns add honge.\n" +
        "• CANCEL = kuch nahi hoga.",
      ui.ButtonSet.YES_NO_CANCEL
    );
    if (resp === ui.Button.CANCEL || resp === ui.Button.CLOSE) {
      notify_("Setup cancel kiya. Koi change nahi hua.");
      return;
    }
    wipeMode = resp === ui.Button.YES;
  }

  // -----------------------------------------------------------------------
  // Sheets ensure karo (create if missing)
  // -----------------------------------------------------------------------
  const dashboard = ensureSheet_(ss, CFG.SHEET_DASHBOARD);
  const review    = ensureSheet_(ss, CFG.SHEET_REVIEW);
  const records   = ensureSheet_(ss, CFG.SHEET_RECORDS);

  // -----------------------------------------------------------------------
  // FIX 1: JournalCheck sheet auto-create
  // Pehle v2 mein ye sirf check karta tha aur warn karta tha
  // Ab auto-create hoti hai headers ke saath
  // Affect: Pehli baar Setup run karne pe JournalCheck sheet
  //         automatically banti hai — aap iske andar VBA data paste
  //         karte hain
  // -----------------------------------------------------------------------
  let journal = ss.getSheetByName(CFG.SHEET_JOURNAL);
  let journalWasCreated = false;

  if (!journal) {
    journal = ss.insertSheet(CFG.SHEET_JOURNAL);
    // Headers set karo — VBA ConvertJournal2() output se exactly match
    journal.getRange(1, 1, 1, JOURNAL_HEADERS.length).setValues([JOURNAL_HEADERS]);
    journalWasCreated = true;
  }

  // -----------------------------------------------------------------------
  // Wipe mode ya Safe Refresh based on user choice
  // -----------------------------------------------------------------------
  if (wipeMode) {
    // Full Reset — sab clear, fresh headers
    dashboard.clear();
    review.clear();
    records.clear();
    review.getRange(1, 1, 1, REVIEW_HEADERS.length).setValues([REVIEW_HEADERS]);
    records.getRange(1, 1, 1, RECORDS_HEADERS.length).setValues([RECORDS_HEADERS]);

    // FIX 2: applyDashboardTemplate_() — Full Reset mein full template
    // Affect: Dashboard ko pehli baar properly setup karta hai —
    //         B2 (Journal No), B3 (Journal Date), A7:A (Keywords),
    //         B7:B (TM Numbers), aur Protection Summary block
    applyDashboardTemplate_(dashboard);

  } else {
    // Safe Refresh — data safe, sirf missing columns add honge
    migrateSheetToHeaders_(review, REVIEW_HEADERS, {
      "Decision": CFG.DECISION_PENDING,
      "Status":   CFG.STATUS_REVIEW,
      "Page No":  "",
    });
    migrateSheetToHeaders_(records, RECORDS_HEADERS, {
      "Decision": "",
      "Page No":  "",
    });

    // Safe Refresh mein sirf labels refresh — data touch nahi hoga
    refreshDashboardLabels_(dashboard);
  }

  // -----------------------------------------------------------------------
  // Dropdowns, formatting, stats
  // -----------------------------------------------------------------------
  backfillDecisionDefaults_(review);
  setupReviewValidation_(review);

  applyUniversalFormatting_(dashboard);
  applyUniversalFormatting_(journal);
  applyUniversalFormatting_(review);
  applyUniversalFormatting_(records);
  applyAlternatingRows_(review);
  applyAlternatingRows_(records);

  updateDashboardStats_();

  // -----------------------------------------------------------------------
  // Final message
  // -----------------------------------------------------------------------
  const mode = wipeMode ? "Full Reset" : "Safe Refresh";
  const journalNote = journalWasCreated
    ? `\n\n✅ JournalCheck sheet nayi banayi gayi hai.\nVBA se data convert karke isme paste karein.`
    : `\n\nℹ️ JournalCheck sheet pehle se exist karti thi — touch nahi ki.`;

  notify_(
    `Setup Complete ✅ (${mode})\n\n` +
      `Sheets ready:\n- ${CFG.SHEET_DASHBOARD}\n- ${CFG.SHEET_JOURNAL}\n- ${CFG.SHEET_REVIEW}\n- ${CFG.SHEET_RECORDS}` +
      journalNote +
      `\n\nAgle steps:\n` +
      `1) Journal No → Dashboard!${CFG.DASH_JOURNAL_NO_A1}\n` +
      `2) Journal Date → Dashboard!${CFG.DASH_JOURNAL_DATE_A1}\n` +
      `3) Keywords → column A row 7 se\n` +
      `4) TM Numbers (6-digit) → column B row 7 se\n` +
      `5) Run Scan`
  );
}


