function applyUniversalFormatting_(sheet) {
  if (!sheet) return;

  const name    = sheet.getName();
  const lastRow = Math.max(1, sheet.getLastRow());
  const lastCol = Math.max(1, sheet.getLastColumn());

  const range = sheet.getRange(1, 1, lastRow, lastCol);
  range.setFontFamily(UI_CFG.FONT_FAMILY);
  range.setHorizontalAlignment(UI_CFG.DEFAULT_H_ALIGN);
  range.setVerticalAlignment(UI_CFG.DEFAULT_V_ALIGN);
  range.setWrapStrategy(UI_CFG.WRAP_STRATEGY);

  sheet.setFrozenRows(
    name === CFG.SHEET_DASHBOARD ? UI_CFG.FREEZE_DASHBOARD : UI_CFG.FREEZE_DEFAULT
  );

  const header = sheet.getRange(1, 1, 1, lastCol);
  header
    .setFontFamily(UI_CFG.FONT_FAMILY)
    .setFontWeight("bold")
    .setBackground(UI_CFG.HEADER_BG)
    .setFontColor(UI_CFG.HEADER_FG)
    .setVerticalAlignment(UI_CFG.DEFAULT_V_ALIGN)
    .setWrapStrategy(UI_CFG.WRAP_STRATEGY);

  const headers = sheet.getRange(1, 1, 1, lastCol).getValues()[0]
    .map(v => String(v || "").trim());
  for (let c = 0; c < headers.length; c++) {
    if (headers[c].toLowerCase().includes("date") && lastRow > 1) {
      sheet.getRange(2, c + 1, lastRow - 1, 1).setNumberFormat(UI_CFG.DATE_FORMAT);
    }
  }

  applySheetLayout_(sheet);
}

function applySheetLayout_(sheet) {
  const cfg = UI_CFG.SHEETS[sheet.getName()];
  if (!cfg) return;

  if (cfg.widths) {
    for (let i = 0; i < cfg.widths.length; i++) {
      sheet.setColumnWidth(i + 1, cfg.widths[i]);
    }
  }
  if (cfg.aligns) {
    const lastRow = Math.max(1, sheet.getLastRow());
    for (let i = 0; i < cfg.aligns.length; i++) {
      const align = cfg.aligns[i] === "C" ? "center"
                  : cfg.aligns[i] === "R" ? "right"
                  : "left";
      sheet.getRange(1, i + 1, lastRow, 1).setHorizontalAlignment(align);
    }
  }
}

function applyAlternatingRows_(sheet) {
  if (!sheet) return;
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow <= 2 || lastCol < 1) return;

  const range = sheet.getRange(2, 1, lastRow - 1, lastCol);
  const bgs   = range.getBackgrounds();
  for (let r = 0; r < bgs.length; r++) {
    if (r % 2 === 1) {
      for (let c = 0; c < lastCol; c++) bgs[r][c] = UI_CFG.ALT_ROW_BG;
    }
  }
  range.setBackgrounds(bgs);
}


