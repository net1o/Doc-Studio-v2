function exportSheetToFiles_(sheet, folder, baseName) {
  const values = sheet.getDataRange().getValues();
  const csv    = toCsv_(values);
  const json   = JSON.stringify(toObjects_(values), null, 2);
  const txt    =
    `Rows: ${Math.max(0, values.length - 1)}\n` +
    `Cols: ${values[0] ? values[0].length : 0}\n` +
    `Generated: ${new Date().toISOString()}\n`;

  folder.createFile(baseName + ".csv",  csv,  MimeType.CSV);
  folder.createFile(baseName + ".json", json, MimeType.PLAIN_TEXT);
  folder.createFile(baseName + ".txt",  txt,  MimeType.PLAIN_TEXT);
}

function toCsv_(values) {
  return values
    .map(row =>
      row.map(v => {
        const s       = v === null || v === undefined ? "" : String(v);
        const escaped = s.replace(/"/g, '""');
        return /[",\n]/.test(escaped) ? `"${escaped}"` : escaped;
      }).join(",")
    ).join("\n");
}

function toObjects_(values) {
  if (!values || values.length === 0) return [];
  const headers = values[0].map(h => String(h || "").trim());
  const out     = [];
  for (let r = 1; r < values.length; r++) {
    const obj = {};
    for (let c = 0; c < headers.length; c++) {
      if (!headers[c]) continue;
      obj[headers[c]] = values[r][c];
    }
    out.push(obj);
  }
  return out;
}


