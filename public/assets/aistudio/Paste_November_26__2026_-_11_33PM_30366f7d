function computeReviewStats_(reviewSheet, filterJournalNo) {
  const stats = {
    total: 0, tmMatches: 0, keywordMatches: 0,
    pending: 0, issue: 0, clear: 0,
    docsGenerated: 0, pdfsGenerated: 0,
    byJournal: {},
  };

  const lastRow = reviewSheet.getLastRow();
  if (lastRow < 2) return stats;

  const headers = reviewSheet.getRange(1, 1, 1, reviewSheet.getLastColumn()).getValues()[0];
  const idx     = makeIndex_(headers);
  const data    = reviewSheet.getRange(2, 1, lastRow - 1, reviewSheet.getLastColumn()).getValues();

  data.forEach(row => {
    const journalNo   = String(row[idx["Journal No"]] || "").trim();
    const decisionRaw = String(row[idx["Decision"]]   || "").trim().toUpperCase();
    const isIssue     = decisionRaw === CFG.DECISION_ISSUE.toUpperCase();
    const hasDoc      = !!String(row[idx["Generated Doc"]] || "").trim();

    if (!stats.byJournal[journalNo]) {
      stats.byJournal[journalNo] = { total: 0, issue: 0, docs: 0 };
    }
    stats.byJournal[journalNo].total++;
    if (isIssue) stats.byJournal[journalNo].issue++;
    if (hasDoc)  stats.byJournal[journalNo].docs++;

    if (filterJournalNo && journalNo !== String(filterJournalNo)) return;

    stats.total++;
    const matchType = String(row[idx["Match Type"]] || "").trim().toUpperCase();
    if (matchType === "TM")      stats.tmMatches++;
    else if (matchType === "KEYWORD") stats.keywordMatches++;

    if (decisionRaw === CFG.DECISION_ISSUE.toUpperCase()) stats.issue++;
    else if (decisionRaw === CFG.DECISION_CLEAR.toUpperCase()) stats.clear++;
    else stats.pending++;

    if (hasDoc) stats.docsGenerated++;
    if (String(row[idx["Generated PDF"]] || "").trim()) stats.pdfsGenerated++;
  });

  return stats;
}

function writeStatsBlock_(sheet, startRow, title, stats) {
  let row = startRow;
  sheet.getRange(row, 1).setValue(title).setFontWeight("bold")
    .setBackground(UI_CFG.HEADER_BG).setFontColor(UI_CFG.HEADER_FG);
  sheet.getRange(row, 1, 1, 2).merge();
  row++;

  const lines = [
    ["Total Matches",                   stats.total],
    ["TM Matches",                      stats.tmMatches],
    ["Keyword Matches",                 stats.keywordMatches],
    ["Pending Review",                  stats.pending],
    ["Issue / Oppose",                  stats.issue],
    ["No Issue / Clear",                stats.clear],
    ["Actionable (Pending + Issue)",    stats.pending + stats.issue],
    ["Docs Generated",                  stats.docsGenerated],
    ["PDFs Generated",                  stats.pdfsGenerated],
  ];

  lines.forEach(([label, value]) => {
    sheet.getRange(row, 1).setValue(label);
    sheet.getRange(row, 2).setValue(value);
    row++;
  });

  return row;
}


