// Ab wapas restore kiya gaya hai.
// Affect: Full Reset mein Dashboard properly setup hota hai —
//         Title, Journal No/Date fields, Keywords/TM headers,
//         Protection Summary block — sab kuch fresh banta hai.
// ========================================

function applyDashboardTemplate_(sheet) {
  // Puri sheet clear karo pehle
  sheet.clear();

  // -----------------------------------------------------------------------
  // Row 1: Title
  // -----------------------------------------------------------------------
  sheet.getRange("A1").setValue("TRADEMARK JOURNAL MONITOR");
  sheet.getRange("A1:B1").merge();
  sheet.getRange("A1:B1")
    .setFontWeight("bold")
    .setFontSize(14)
    .setBackground(UI_CFG.HEADER_BG)
    .setFontColor(UI_CFG.HEADER_FG)
    .setHorizontalAlignment("center");

  // -----------------------------------------------------------------------
  // Rows 2-3: Journal No aur Date input fields
  // -----------------------------------------------------------------------
  sheet.getRange("A2").setValue("Journal No");
  sheet.getRange("A3").setValue("Journal Date");
  sheet.getRange("B2").setNumberFormat("@");                // text format — number auto-convert na ho
  sheet.getRange("B3").setNumberFormat("dd-mmm-yyyy");      // date display format
  sheet.getRange("A2:A3")
    .setBackground("#f3f4f6")
    .setFontWeight("bold");
  sheet.getRange("A2:B3")
    .setBorder(true, true, true, true, true, true);

  // -----------------------------------------------------------------------
  // Row 4-5: blank spacer
  // -----------------------------------------------------------------------
  sheet.getRange("A4").setValue("");
  sheet.getRange("A5").setValue("");

  // -----------------------------------------------------------------------
  // Row 6: Keywords aur TM Numbers column headers
  // -----------------------------------------------------------------------
  sheet.getRange("A6").setValue("Keywords");
  sheet.getRange("B6").setValue("TM Numbers (6-digit)");
  sheet.getRange("A6:B6")
    .setFontWeight("bold")
    .setBackground(UI_CFG.HEADER_BG)
    .setFontColor(UI_CFG.HEADER_FG);

  // -----------------------------------------------------------------------
  // Freeze rows — row 6 tak freeze (keywords list scroll ho sake)
  // -----------------------------------------------------------------------
  sheet.setFrozenRows(UI_CFG.FREEZE_DASHBOARD);

  // -----------------------------------------------------------------------
  // Column widths
  // -----------------------------------------------------------------------
  sheet.setColumnWidth(1, 500);
  sheet.setColumnWidth(2, 400);

  // -----------------------------------------------------------------------
  // Protection Summary block (cols D-E) — stats yahan update hote hain
  // -----------------------------------------------------------------------
  buildProtectionSummaryLabels_(sheet);
}


