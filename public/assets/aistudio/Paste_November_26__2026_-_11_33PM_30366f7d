function generateDocsAndPdfs() {
  const ss = SpreadsheetApp.getActive();

  const dashboard = ss.getSheetByName(CFG.SHEET_DASHBOARD);
  const review    = ss.getSheetByName(CFG.SHEET_REVIEW);
  const records   = ensureSheet_(ss, CFG.SHEET_RECORDS);

  if (!dashboard || !review) {
    notify_("Dashboard ya Review sheet nahi mili. Setup chalao pehle.");
    return;
  }

  const journalNo   = String(dashboard.getRange(CFG.DASH_JOURNAL_NO_A1).getValue() || "").trim();
  const journalDate = dashboard.getRange(CFG.DASH_JOURNAL_DATE_A1).getValue();
  if (!journalNo) {
    notify_(`Dashboard!${CFG.DASH_JOURNAL_NO_A1} khali hai.`);
    return;
  }

  const reviewData = review.getDataRange().getValues();
  if (reviewData.length < 2) {
    notify_("Review khali hai. Pehle Scan chalao.");
    return;
  }

  const headers = reviewData[0];
  const idx     = makeIndex_(headers);

  for (const h of REVIEW_HEADERS) {
    if (!(h in idx)) {
      notify_(`Review sheet mein column missing: ${h}. Setup dobara chalao.`);
      return;
    }
  }

  const rootFolder   = DriveApp.getFolderById(CFG.MAIN_FOLDER_ID);
  const journalFolder = getOrCreateFolder_(rootFolder, `Journal_${journalNo}`);
  const docsFolder   = getOrCreateFolder_(journalFolder, "Docs");

  let processed   = 0;
  const now       = new Date();
  let serialStart = getNextSerial_(review, idx["Generated Doc"]);

  const recordRows = [];

  for (let r = 1; r < reviewData.length; r++) {
    const row = reviewData[r];

    const status      = String(row[idx["Status"]]        || "").trim();
    const existingDoc = String(row[idx["Generated Doc"]] || "").trim();

    if (status.toLowerCase() !== CFG.STATUS_OK.toLowerCase()) continue;
    if (existingDoc) continue;

    const applicationNo = String(row[idx["Application No"]] || "").trim();
    const caseNo        = String(row[idx["Case No"]]         || "").trim();
    const title         = String(row[idx["Title"]]           || "").trim();
    const classNo       = String(row[idx["Class"]]           || "").trim();
    const pageNo        = String(row[idx["Page No"]]         || "").trim();

    const serialNo = CFG.SERIAL_PREFIX + String(serialStart).padStart(CFG.SERIAL_PAD, "0");
    serialStart++;

    // File name: CaseNo_Title_AppNo_JournalNo
    const safeCaseNo  = (caseNo  || "NOCASE").replace(/[^a-zA-Z0-9]+/g, "_");
    const safeTitle   = title    ? title.replace(/[^a-zA-Z0-9]+/g, "_").slice(0, 40) : "TITLE";
    const safeAppNo   = (applicationNo || "NOAPP").replace(/[^a-zA-Z0-9]+/g, "_");
    const safeJournal = String(journalNo || "NOJRN").replace(/[^a-zA-Z0-9]+/g, "_");
    const docName     = `${safeCaseNo}_${safeTitle}_${safeAppNo}_${safeJournal}`;

    const mergeTags = {
      "{{S_NO}}":           serialNo,
      "{{JOURNAL_NO}}":     String(journalNo),
      "{{CASE_NO}}":        caseNo || "NOT FOUND",
      "{{APPLICATION_NO}}": applicationNo,
      "{{CLASS}}":          classNo,
      "{{TITLE}}":          title,
      "{{PAGE_NO}}":        pageNo,
      "{image}":            "",
    };

    try {
      const docId  = generateDocumentFromTemplate_(CFG.TEMPLATE_ID, docsFolder, docName, mergeTags);
      const docUrl = `https://docs.google.com/document/d/${docId}/edit`;

      review.getRange(r + 1, idx["Generated Doc"] + 1).setValue(docUrl);
      review.getRange(r + 1, idx["Generated PDF"] + 1).setValue("");
      review.getRange(r + 1, idx["Generated At"]  + 1).setValue(now);
      review.getRange(r + 1, idx["Status"]         + 1).setValue(CFG.STATUS_DONE);

      recordRows.push([
        journalNo,
        journalDate || "",
        applicationNo,
        caseNo || "NOT FOUND",
        classNo,
        row[idx["Applicant Name and Address"]] || "",
        title,
        row[idx["Agent Name and Address"]]     || "",
        applicationNo,
        row[idx["Date of Filing"]]             || "",
        row[idx["Matched Term"]]               || "",
        row[idx["Match Type"]]                 || "",
        row[idx["Decision"]]                   || "",
        "",        // Remarks
        docUrl,
        "",        // PDF URL
        now,
        pageNo,
      ]);

      processed++;
    } catch (e) {
      review.getRange(r + 1, idx["Status"] + 1).setValue(
        "ERROR: " + (e && e.message ? e.message : String(e))
      );
    }
  }

  ensureRecordsHeaders_(records);
  if (recordRows.length > 0) {
    appendRows_(records, recordRows);
    applyUniversalFormatting_(records);
    applyAlternatingRows_(records);
  }

  applyUniversalFormatting_(review);
  applyUniversalFormatting_(records);
  updateDashboardStats_();

  notify_(
    processed > 0
      ? `Docs Generated ✅\n\n${processed} DOC(s) bane\nFolder: Journal_${journalNo}/Docs\n\n` +
          `Ab Doc mein images add karo, phir "Convert to PDF" chalao.`
      : `Status = '${CFG.STATUS_OK}' wali koi row nahi mili (ya already generated hai).`
  );
}

function convertGeneratedDocsToPdfs() {
  const ss = SpreadsheetApp.getActive();

  const dashboard = ss.getSheetByName(CFG.SHEET_DASHBOARD);
  const review    = ss.getSheetByName(CFG.SHEET_REVIEW);

  if (!dashboard || !review) {
    notify_("Dashboard ya Review sheet nahi mili. Setup chalao pehle.");
    return;
  }

  const journalNo = String(
    dashboard.getRange(CFG.DASH_JOURNAL_NO_A1).getValue() || ""
  ).trim();
  if (!journalNo) {
    notify_(`Dashboard!${CFG.DASH_JOURNAL_NO_A1} khali hai.`);
    return;
  }

  const reviewData = review.getDataRange().getValues();
  if (reviewData.length < 2) {
    notify_("Review sheet khali hai.");
    return;
  }

  const headers = reviewData[0];
  const idx     = makeIndex_(headers);

  const required = [
    "Status", "Generated Doc", "Generated PDF",
    "Application No", "Case No", "Title", "Journal No",
  ];
  for (const h of required) {
    if (!(h in idx)) {
      notify_(`Review sheet mein column missing: ${h}`);
      return;
    }
  }

  const rootFolder    = DriveApp.getFolderById(CFG.MAIN_FOLDER_ID);
  const journalFolder = getOrCreateFolder_(rootFolder, `Journal_${journalNo}`);
  const pdfsFolder    = getOrCreateFolder_(journalFolder, "PDFs");

  let processed = 0;
  let skipped   = 0;
  let errors    = 0;

  for (let r = 1; r < reviewData.length; r++) {
    const row = reviewData[r];

    const status      = String(row[idx["Status"]]           || "").trim();
    const docUrl      = String(row[idx["Generated Doc"]]    || "").trim();
    const existingPdf = String(row[idx["Generated PDF"]]    || "").trim();

    // Sirf woh rows jinka Doc ban chuka hai lekin PDF abhi nahi
    if (status.toUpperCase() !== CFG.STATUS_DONE.toUpperCase()) { skipped++; continue; }
    if (!docUrl || existingPdf)                                  { skipped++; continue; }

    const docIdMatch = docUrl.match(/\/d\/([a-zA-Z0-9-_]+)/);
    if (!docIdMatch) {
      review.getRange(r + 1, idx["Status"] + 1).setValue("ERROR: Invalid Doc URL");
      errors++;
      continue;
    }
    const docId = docIdMatch[1];

    const safeCaseNo  = String(row[idx["Case No"]]         || "NOCASE").trim().replace(/[^a-zA-Z0-9]+/g, "_");
    const safeTitle   = String(row[idx["Title"]]           || "TITLE").trim().replace(/[^a-zA-Z0-9]+/g, "_").slice(0, 40);
    const safeAppNo   = String(row[idx["Application No"]]  || "NOAPP").trim().replace(/[^a-zA-Z0-9]+/g, "_");
    const safeJournal = String(row[idx["Journal No"]]      || journalNo || "NOJRN").trim().replace(/[^a-zA-Z0-9]+/g, "_");
    const baseName    = `${safeCaseNo}_${safeTitle}_${safeAppNo}_${safeJournal}`;

    try {
      const pdfUrl = exportDocToPdf_(docId, pdfsFolder, baseName);
      review.getRange(r + 1, idx["Generated PDF"] + 1).setValue(pdfUrl);
      if ("Generated At" in idx) {
        review.getRange(r + 1, idx["Generated At"] + 1).setValue(new Date());
      }
      processed++;
    } catch (e) {
      review.getRange(r + 1, idx["Status"] + 1).setValue(
        "ERROR PDF: " + (e && e.message ? e.message : String(e))
      );
      errors++;
    }
  }

  applyUniversalFormatting_(review);
  applyAlternatingRows_(review);
  updateDashboardStats_();

  notify_(
    `PDF Conversion Complete ✅\n\n` +
    `Processed: ${processed}\nSkipped: ${skipped}\nErrors: ${errors}\n\n` +
    `Folder: Journal_${journalNo}/PDFs`
  );
}


