' Extract field using regex
Function ExtractField(text As String, pattern As String) As String
Dim regex As Object
Set regex = CreateObject("VBScript.RegExp")
regex.pattern = pattern
regex.IgnoreCase = True
If regex.Test(text) Then
ExtractField = Trim(regex.Execute(text)(0).SubMatches(0))
Else
ExtractField = ""
End If
End Function
' Extract multi-line field (e.g., addresses)
Function ExtractMultiLineField(text As String, pattern As String) As String
Dim regex As Object
Set regex = CreateObject("VBScript.RegExp")
regex.pattern = pattern
regex.IgnoreCase = True
regex.MultiLine = True
If regex.Test(text) Then
ExtractMultiLineField = Trim(regex.Execute(text)(0).SubMatches(0))
Else
ExtractMultiLineField = ""
End If
End Function
' Clean text (replace newlines with spaces)
Function CleanText(text As String) As String
CleanText = Replace(Replace(text, vbCr, " "), vbLf, " ")
End Function
