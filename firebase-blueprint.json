{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated workspace owner record (no raw PII stored).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128,
          "description": "Firebase Auth UID matching the document path userId."
        },
        "displayName": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional display label for the workspace owner."
        },
        "activeWorkspaceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64,
          "description": "Identifier of the active workspace configuration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server last-updated timestamp."
        }
      },
      "required": ["uid", "activeWorkspaceId", "createdAt", "updatedAt"]
    },
    "WorkspaceConfig": {
      "title": "WorkspaceConfig",
      "description": "Journal monitoring configuration, watchlists, sheet mapping, paper size, and theme settings.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "workspaceId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 64
        },
        "journalNo": {
          "type": "string",
          "maxLength": 64
        },
        "journalDate": {
          "type": "string",
          "maxLength": 64
        },
        "keywordMatchMode": {
          "type": "string",
          "enum": ["word", "contains"]
        },
        "serialPrefix": {
          "type": "string",
          "maxLength": 32
        },
        "serialPad": {
          "type": "integer"
        },
        "keywords": {
          "type": "array",
          "description": "Watchlist keyword terms (bounded to 10000 items)."
        },
        "tmNumbers": {
          "type": "array",
          "description": "Watchlist TM application numbers (bounded to 20000 items)."
        },
        "caseSheetConfig": {
          "type": "object"
        },
        "paperSize": {
          "type": "object"
        },
        "universalSettings": {
          "type": "object"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "workspaceId",
        "journalNo",
        "journalDate",
        "keywordMatchMode",
        "serialPrefix",
        "serialPad",
        "keywords",
        "tmNumbers",
        "createdAt",
        "updatedAt"
      ]
    },
    "CaseRecord": {
