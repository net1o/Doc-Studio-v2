        "clientName": {
          "type": "string",
          "maxLength": 240
        },
        "prefix": {
          "type": "string",
          "maxLength": 32
        },
        "clientCode": {
          "type": "string",
          "maxLength": 64
        },
        "rawCaseNo": {
          "type": "string",
          "maxLength": 128
        },
        "applicationName": {
          "type": "string",
          "maxLength": 300
        },
        "classNo": {
          "type": "string",
          "maxLength": 32
        },
        "status": {
