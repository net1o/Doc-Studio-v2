        "reviewId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "journalNo": {
          "type": "string",
          "maxLength": 64
        },
        "journalDate": {
          "type": "string",
          "maxLength": 64
        },
        "applicationNo": {
          "type": "string",
          "maxLength": 64
        },
        "caseNo": {
          "type": "string",
          "maxLength": 240
        },
        "title": {
          "type": "string",
          "maxLength": 500
        },
