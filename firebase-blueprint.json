        "sheetRowIndex": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "caseId",
        "tmNumber",
        "caseNo",
        "clientName",
        "createdAt",
        "updatedAt"
      ]
    },
    "JournalCheckRecord": {
      "title": "JournalCheckRecord",
