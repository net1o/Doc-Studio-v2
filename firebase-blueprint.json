  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Authenticated user's private workspace root document."
    },
    "/users/{userId}/workspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/WorkspaceConfig" },
      "description": "User's journal configuration, watchlists, and UI/paper settings."
    },
    "/users/{userId}/cases/{caseId}": {
      "schema": { "$ref": "#/entities/CaseRecord" },
      "description": "User's trademark case records."
    },
    "/users/{userId}/journalRows/{rowId}": {
      "schema": { "$ref": "#/entities/JournalCheckRecord" },
      "description": "User's imported Trade Marks Journal entries."
    },
    "/users/{userId}/reviewRows/{reviewId}": {
      "schema": { "$ref": "#/entities/ReviewQueueRecord" },
      "description": "User's matched trademark review queue items."
    },
    "/users/{userId}/records/{recordId}": {
      "schema": { "$ref": "#/entities/RecordItem" },
      "description": "User's generated document log records."
    },
    "/users/{userId}/generatedDocs/{docId}": {
      "schema": { "$ref": "#/entities/GeneratedDocRecord" },
      "description": "User's Journal 909 document snapshots."
    }
  }
}
